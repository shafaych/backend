{
  "name": "ghs-invisible-player",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still src/index.ts Film",
    "render:silent": "remotion render src/index.ts Film out/video.mp4 --codec=h264 --concurrency=4",
    "audio": "python3 tools/vo.py && python3 tools/mix.py",
    "mux": "ffmpeg -y -i out/video.mp4 -i audio/master.wav -c:v copy -c:a aac -b:a 256k -ac 2 -shortest out/GHS_The_Invisible_Player.mp4"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@remotion/cli": "^4.0.537",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.537",
    "typescript": "^7.0.2"
  }
}
