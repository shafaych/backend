 "segments": [
  {
   "id": 1,
   "text": "If you're looking for a reliable manufacturer for your sportswear brand or team, let me show you what we do.",
   "start": 5.9,
   "speechEnd": 13.9,
   "end": 14.3
  },
  {
   "id": 2,
   "text": "We're GHS Custom Gear, a custom sportswear manufacturer based in Sialkot, Pakistan.",
   "start": 14.3,
   "speechEnd": 19.1,
   "end": 19.5
  },
  {
   "id": 3,
   "text": "We run our own manufacturing facility, producing custom soccer uniforms, basketball jerseys, American football uniforms, tracksuits, hoodies, and training wear.",
   "start": 19.5,
   "speechEnd": 27.5,
   "end": 27.9
  },
  {
   "id": 4,
   "text": "From fabric selection and cutting to stitching, sublimation printing, and embroidery, our experienced production team handles the manufacturing process.",
   "start": 27.9,
   "speechEnd": 35.5,
   "end": 35.9
  },
  {
   "id": 5,
   "text": "Our priority goes beyond making products. We focus on quality, accurate customization, and dependable manufacturing.",
   "start": 35.9,
   "speechEnd": 41.9,
   "end": 42.3
  },
  {
   "id": 6,
   "text": "We also offer custom designs, private labeling, and bulk production.",
   "start": 42.3,
   "speechEnd": 46.3,
   "end": 46.699999999999996
  },
  {
   "id": 7,
   "text": "And here's something important: our minimum order quantity starts at just ten pieces.",
   "start": 46.699999999999996,
   "speechEnd": 51.9,
   "end": 52.3
  }
 ],
