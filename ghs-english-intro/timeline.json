 "segments": [
  {
   "id": 1,
   "text": "If you're looking for a reliable manufacturer for your sportswear brand or team, let me show you what we do.",
   "start": 5.9,
   "speechEnd": 13.307407407407407,
   "end": 13.707407407407407
  },
  {
   "id": 2,
   "text": "We're GHS Custom Gear, a custom sportswear manufacturing company based in Sialkot, Pakistan.",
   "start": 13.707407407407407,
   "speechEnd": 18.522222222222222,
   "end": 18.92222222222222
  },
  {
   "id": 3,
   "text": "We operate our own manufacturing facility, producing custom soccer uniforms, basketball jerseys, American football uniforms, tracksuits, hoodies, and training wear.",
   "start": 18.92222222222222,
   "speechEnd": 26.32962962962963,
   "end": 26.729629629629628
  },
  {
   "id": 4,
   "text": "From fabric selection and cutting to stitching, sublimation printing, and embroidery, our experienced production team handles the manufacturing process.",
   "start": 26.729629629629628,
   "speechEnd": 33.766666666666666,
   "end": 34.166666666666664
  },
  {
   "id": 5,
   "text": "Our priority goes beyond making products. We focus on quality, accurate customization, and dependable manufacturing.",
   "start": 34.166666666666664,
   "speechEnd": 39.72222222222222,
   "end": 40.12222222222222
  },
  {
   "id": 6,
   "text": "We also offer custom designs, private labeling, and bulk production.",
   "start": 40.12222222222222,
   "speechEnd": 43.82592592592592,
   "end": 44.22592592592592
  },
  {
   "id": 7,
   "text": "And here's something important: our minimum order quantity starts at just ten pieces.",
   "start": 44.22592592592592,
   "speechEnd": 49.04074074074074,
   "end": 49.440740740740736
  }
 ],
